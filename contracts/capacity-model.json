{
  "contract_id": "cardeex.capacity-model",
  "contract_version": "0.1.0",
  "status": "planning_assumptions_not_benchmarks",
  "as_of": "2026-09-07",
  "purpose": "Capacity arithmetic for architecture gates; it is not measured production performance, a vendor guarantee, or a cost forecast.",
  "scope_axes_are_independent": true,
  "scope_allowlist": [
    "car",
    "lcv",
    "motorcycle",
    "motorhome"
  ],
  "excluded_from_this_contract": [
    "trailer",
    "caravan",
    "construction_machine",
    "agricultural_machine"
  ],
  "units": {
    "storage": "decimal_bytes",
    "throughput": "bytes_per_second",
    "rate": "operations_per_second",
    "time": "seconds_unless_field_name_states_otherwise"
  },
  "common_assumptions": {
    "seconds_per_day": 86400,
    "days_per_month": 30,
    "steady_state_headroom_factor": 2.0,
    "fetches_per_active_listing_per_day": 1.0,
    "average_fetch_latency_seconds": 0.8,
    "average_fetch_response_compressed_bytes": 45000,
    "raw_unique_payload_ratio_per_fetch": 0.10,
    "raw_retention_days": 90,
    "raw_capture_manifest_compressed_bytes": 250,
    "raw_capture_rows_per_manifest_batch": 1000,
    "raw_captures_per_object_bundle": 1000,
    "object_storage_reserve_factor": 1.25,
    "events_per_active_listing_per_day": 1.0,
    "normalized_history_retention_days": 730,
    "average_event_log_bytes": 1500,
    "event_log_retention_days": 7,
    "event_log_replication_factor": 3,
    "planning_event_qps_per_log_partition": 500,
    "projection_mutation_ratio_per_event": 0.10,
    "current_projection_record_bytes": 2500,
    "current_projection_index_overhead_factor": 2.20,
    "current_projection_replication_factor": 3,
    "serving_api_reads_per_active_listing_per_day": 0.25,
    "average_serving_api_response_bytes": 4000,
    "media_capture_listing_ratio_per_day": 0.01,
    "media_retention_days": 30,
    "average_images_per_media_capture": 12,
    "average_image_bytes": 240000,
    "media_unique_content_ratio": 0.70,
    "initial_media_backfill_target_days": 30,
    "delta_stream_count_reference": 1000000,
    "average_delta_poll_response_compressed_bytes": 5000,
    "recovery_backlog_hours": 24,
    "recovery_clear_hours": 8,
    "historical_observation_compressed_bytes": 1600,
    "historical_table_overhead_factor": 1.15,
    "historical_target_data_file_bytes": 500000000,
    "historical_full_scan_target_hours": 24
  },
  "assumption_notes": {
    "raw_unique_payload_ratio_per_fetch": "Planning assumption for content-addressed payload bytes only. Every fetch still creates an evidence row even when the response is unchanged. Measure per source/country and only deduplicate inside compatible rights, retention and storage-security domains.",
    "raw_capture_manifest_compressed_bytes": "Planning bytes per retained FetchAttempt/RawCapture evidence row, including unchanged responses and media fetches; deduplication never reduces this row count.",
    "object_storage_reserve_factor": "Planning reserve for durability and operational slack, not a claim about a provider's physical encoding.",
    "planning_event_qps_per_log_partition": "Planning assumption used only to size a minimum partition count; replace with benchmarked throughput at the selected record size and durability settings.",
    "projection_mutation_ratio_per_event": "Planning proxy for events that actually alter the current projection; presence events remain historical evidence even when current state is unchanged.",
    "media_capture_listing_ratio_per_day": "Planning proxy for new or changed media sets; media traffic and rights are expected to dominate uncertainty. The unique-content ratio applies only inside compatible rights, retention and storage-security domains.",
    "scope_axes_are_independent": "The active-listing profiles and the ten-billion historical-observation profile are separate dimensions. Do not add them unless a deployment explicitly targets both at the same time."
  },
  "equations": {
    "fetches_per_day": "active_listings * fetches_per_active_listing_per_day",
    "steady_fetch_qps": "fetches_per_day / seconds_per_day",
    "design_fetch_qps": "steady_fetch_qps * steady_state_headroom_factor",
    "recovery_fetch_qps": "steady_fetch_qps * (1 + recovery_backlog_hours / recovery_clear_hours)",
    "design_fetch_concurrency": "ceil(design_fetch_qps * average_fetch_latency_seconds)",
    "required_peak_fetch_qps": "max(design_fetch_qps, recovery_fetch_qps)",
    "required_peak_fetch_concurrency": "ceil(required_peak_fetch_qps * average_fetch_latency_seconds)",
    "steady_fetch_ingress_bytes_per_second": "steady_fetch_qps * average_fetch_response_compressed_bytes",
    "design_fetch_ingress_bytes_per_second": "design_fetch_qps * average_fetch_response_compressed_bytes",
    "required_peak_fetch_ingress_bytes_per_second": "required_peak_fetch_qps * average_fetch_response_compressed_bytes",
    "events_per_day": "active_listings * events_per_active_listing_per_day",
    "steady_event_qps": "events_per_day / seconds_per_day",
    "design_event_qps": "steady_event_qps * steady_state_headroom_factor",
    "required_peak_event_qps": "max(design_event_qps, recovery_fetch_qps)",
    "minimum_log_partitions_by_qps": "ceil(required_peak_event_qps / planning_event_qps_per_log_partition)",
    "event_log_reserved_bytes": "events_per_day * event_log_retention_days * average_event_log_bytes * event_log_replication_factor",
    "non_media_raw_capture_manifest_rows_retained": "fetches_per_day * raw_retention_days",
    "recurring_media_capture_manifest_rows_retained": "media_image_fetches_per_day * raw_retention_days",
    "raw_capture_manifest_rows_retained": "non_media_raw_capture_manifest_rows_retained + recurring_media_capture_manifest_rows_retained",
    "raw_evidence_manifest_batches_retained": "ceil(raw_capture_manifest_rows_retained / raw_capture_rows_per_manifest_batch)",
    "raw_unique_payloads_retained": "non_media_raw_capture_manifest_rows_retained * raw_unique_payload_ratio_per_fetch",
    "raw_object_bundles_retained": "ceil(raw_unique_payloads_retained / raw_captures_per_object_bundle)",
    "raw_logical_bytes": "raw_unique_payloads_retained * average_fetch_response_compressed_bytes",
    "raw_reserved_bytes": "raw_logical_bytes * object_storage_reserve_factor",
    "raw_manifest_reserved_bytes": "raw_capture_manifest_rows_retained * raw_capture_manifest_compressed_bytes * historical_table_overhead_factor * object_storage_reserve_factor",
    "media_captures_per_day": "active_listings * media_capture_listing_ratio_per_day",
    "media_image_fetches_per_day": "media_captures_per_day * average_images_per_media_capture",
    "steady_media_fetch_qps": "media_image_fetches_per_day / seconds_per_day",
    "design_media_fetch_qps": "steady_media_fetch_qps * steady_state_headroom_factor",
    "steady_media_ingress_bytes_per_second": "steady_media_fetch_qps * average_image_bytes",
    "design_media_ingress_bytes_per_second": "design_media_fetch_qps * average_image_bytes",
    "design_total_ingress_bytes_per_second": "design_fetch_ingress_bytes_per_second + design_media_ingress_bytes_per_second",
    "initial_media_image_fetches": "active_listings * average_images_per_media_capture",
    "initial_media_capture_manifest_rows": "initial_media_image_fetches",
    "initial_media_manifest_batches": "ceil(initial_media_capture_manifest_rows / raw_capture_rows_per_manifest_batch)",
    "initial_media_manifest_reserved_bytes": "initial_media_capture_manifest_rows * raw_capture_manifest_compressed_bytes * historical_table_overhead_factor * object_storage_reserve_factor",
    "initial_media_unique_images": "initial_media_image_fetches * media_unique_content_ratio",
    "initial_media_logical_bytes": "initial_media_unique_images * average_image_bytes",
    "initial_media_reserved_bytes": "initial_media_logical_bytes * object_storage_reserve_factor",
    "initial_media_steady_fetch_qps": "initial_media_image_fetches / (initial_media_backfill_target_days * seconds_per_day)",
    "initial_media_design_fetch_qps": "initial_media_steady_fetch_qps * steady_state_headroom_factor",
    "initial_media_design_ingress_bytes_per_second": "initial_media_design_fetch_qps * average_image_bytes",
    "required_peak_combined_fetch_qps_if_media_backfill_parallel": "required_peak_fetch_qps + design_media_fetch_qps + initial_media_design_fetch_qps",
    "required_peak_combined_ingress_if_media_backfill_parallel": "required_peak_fetch_ingress_bytes_per_second + design_media_ingress_bytes_per_second + initial_media_design_ingress_bytes_per_second",
    "media_unique_images_retained": "active_listings * media_capture_listing_ratio_per_day * media_retention_days * average_images_per_media_capture * media_unique_content_ratio",
    "media_logical_bytes": "media_unique_images_retained * average_image_bytes",
    "media_reserved_bytes": "media_logical_bytes * object_storage_reserve_factor",
    "current_projection_logical_bytes": "active_listings * current_projection_record_bytes * current_projection_index_overhead_factor",
    "current_projection_reserved_bytes": "current_projection_logical_bytes * current_projection_replication_factor",
    "steady_projection_write_qps": "steady_event_qps * projection_mutation_ratio_per_event",
    "design_projection_write_qps": "steady_projection_write_qps * steady_state_headroom_factor",
    "required_peak_projection_write_qps": "required_peak_event_qps * projection_mutation_ratio_per_event",
    "steady_serving_api_read_qps": "active_listings * serving_api_reads_per_active_listing_per_day / seconds_per_day",
    "design_serving_api_read_qps": "steady_serving_api_read_qps * steady_state_headroom_factor",
    "steady_serving_api_egress_bytes_per_second": "steady_serving_api_read_qps * average_serving_api_response_bytes",
    "effective_history_observations_retained": "events_per_day * normalized_history_retention_days",
    "effective_history_logical_bytes": "effective_history_observations_retained * historical_observation_compressed_bytes",
    "effective_history_reserved_bytes": "effective_history_logical_bytes * historical_table_overhead_factor * object_storage_reserve_factor",
    "days_to_accumulate_10b_history": "10000000000 / events_per_day",
    "combined_steady_state_reserved_bytes": "raw_reserved_bytes + raw_manifest_reserved_bytes + media_reserved_bytes + current_projection_reserved_bytes + event_log_reserved_bytes + effective_history_reserved_bytes",
    "combined_initial_backfill_peak_reserved_bytes": "raw_reserved_bytes + raw_manifest_reserved_bytes + initial_media_manifest_reserved_bytes + max(media_reserved_bytes, initial_media_reserved_bytes) + current_projection_reserved_bytes + event_log_reserved_bytes + effective_history_reserved_bytes",
    "steady_media_share_of_combined_reserved": "media_reserved_bytes / combined_steady_state_reserved_bytes",
    "initial_media_share_of_combined_backfill_peak_reserved": "initial_media_reserved_bytes / combined_initial_backfill_peak_reserved_bytes",
    "delta_polls_per_stream_per_day": "seconds_per_day / delta_interval_seconds",
    "steady_delta_poll_qps": "delta_stream_count_reference / delta_interval_seconds",
    "design_delta_poll_qps": "steady_delta_poll_qps * steady_state_headroom_factor",
    "design_delta_poll_ingress_bytes_per_second": "design_delta_poll_qps * average_delta_poll_response_compressed_bytes",
    "historical_logical_bytes": "historical_observations * historical_observation_compressed_bytes",
    "historical_table_bytes": "historical_logical_bytes * historical_table_overhead_factor",
    "historical_reserved_bytes": "historical_table_bytes * object_storage_reserve_factor",
    "historical_target_data_files": "ceil(historical_table_bytes / historical_target_data_file_bytes)",
    "historical_full_scan_bytes_per_second": "historical_table_bytes / (historical_full_scan_target_hours * 3600)",
    "historical_design_scan_bytes_per_second": "historical_full_scan_bytes_per_second * steady_state_headroom_factor"
  },
