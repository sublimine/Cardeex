{
  "nodes": [
    {
      "id": "mission",
      "type": "text",
      "text": "# Cardeex\nInventario digital vivo por dealer y POS\nES · FR · DE · NL · BE · CH\nBase de diseño; capacidad real por demostrar",
      "x": 0,
      "y": -580,
      "width": 480,
      "height": 195,
      "color": "4"
    },
    {
      "id": "scope",
      "type": "text",
      "text": "# Adquirir amplio, certificar por clase\nCar · LCV · Motorcycle · Motorhome\nUna integración por fuente admitida\nPesados posteriores; caravanas/maquinaria fuera",
      "x": 540,
      "y": -580,
      "width": 430,
      "height": 195,
      "color": "5"
    },
    {
      "id": "truth",
      "type": "text",
      "text": "# Reglas de verdad\nAnuncio ≠ oferta ≠ vehículo\nDealer ≠ tenant ≠ POS\nEvidencia temporal, incertidumbre explícita",
      "x": 1030,
      "y": -580,
      "width": 420,
      "height": 195,
      "color": "3"
    },
    {
      "id": "registry",
      "type": "text",
      "text": "# Registro y admisión\nFuentes, superficies, namespaces\nPermisos, finalidad, retención y presupuesto\nSin admisión vigente no hay adquisición",
      "x": 0,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "5"
    },
    {
      "id": "streams",
      "type": "text",
      "text": "# Streams y alcance\nPaís/clase/filtros y revisiones\nPlan finito de particiones\nGobernador compartido por origen",
      "x": 420,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "5"
    },
    {
      "id": "capture",
      "type": "text",
      "text": "# Capturas duraderas\nRuns, fetches, manifiestos y hashes\nRaw retenido + evidencia de presencia\nReplay sin red y supresión propagada",
      "x": 840,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "3"
    },
    {
      "id": "observations",
      "type": "text",
      "text": "# Observaciones y afirmaciones\nPresencia separada de atributos\nOrigen y precisión de cada campo\nTiempo de fuente, observación y conocimiento",
      "x": 1260,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "3"
    },
    {
      "id": "resolution",
      "type": "text",
      "text": "# Identidad y divergencias\nCandidatos → decisión explicable\nMerge/split reversible; conflictos conservados\nPrecio en oferta, no en vehículo",
      "x": 1680,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "3"
    },
    {
      "id": "reconciliation",
      "type": "text",
      "text": "# Reconciliación\nCenso completo + alcance comparable\nParcial no produce bajas\nAusencia ≠ venta; correcciones compensatorias",
      "x": 1260,
      "y": 40,
      "width": 340,
      "height": 175,
      "color": "2"
    },
    {
      "id": "dealer",
      "type": "text",
      "text": "# Inventario de dealer\nMembresía efectiva por evidencia\nPOS asignado/ambiguo/sin asignar\nContadores por item, anuncio y vehículo",
      "x": 2100,
      "y": -230,
      "width": 340,
      "height": 175,
      "color": "4"
    },
    {
      "id": "api",
      "type": "text",
      "text": "# API y consumidores\nSnapshots con corte y paginación\nEventos reintentables y continuación\nAislamiento por cliente y permisos vigentes",
      "x": 2520,
      "y": -230,
      "width": 380,
      "height": 175,
      "color": "4"
    },
    {
      "id": "quality",
      "type": "text",
      "text": "# Calidad y cobertura\nPaís × clase × tipo de fuente\nDenominador conocido/estimado/desconocido\nFrescura y completitud visibles",
      "x": 2100,
      "y": 40,
      "width": 340,
      "height": 175,
      "color": "2"
    },
    {
      "id": "runtime",
      "type": "text",
      "text": "# Ejecución y recuperación\nColas, leases/fences, outbox y backpressure\nReintentos acotados y circuit breakers\nRestauración sin resucitar datos suprimidos",
      "x": 420,
      "y": 340,
      "width": 520,
      "height": 205,
      "color": "2"
    },
    {
      "id": "capacity",
      "type": "text",
      "text": "# Capacidad medida\nActivos ≠ observaciones históricas\nCarga, medios, índices, retención y recuperación\nPerfiles y coste con supuestos explícitos",
      "x": 1030,
      "y": 340,
      "width": 490,
      "height": 205,
      "color": "2"
    },
    {
      "id": "evolution",
      "type": "text",
      "text": "# Evolución controlada\nVersiones independientes y pruebas\nRebuild en sombra, canary y rollback\nSin cambios silenciosos de significado",
      "x": 1620,
      "y": 340,
      "width": 460,
      "height": 205,
      "color": "6"
    },
    {
      "id": "next_discovery",
      "type": "text",
      "text": "# Siguiente: descubrimiento\nDiseñar fuentes, dealers y POS a escala\nCandidatos con procedencia y fronteras finitas\nMedición independiente de cobertura",
      "x": 0,
      "y": 700,
      "width": 480,
      "height": 200,
      "color": "6"
    },
    {
      "id": "next_scraping",
      "type": "text",
      "text": "# Después: estrategias de scraping\nCapacidades y acceso por superficie\nÍndice → detalle → medios\nEnumeración, cambios y reconciliación",
      "x": 560,
      "y": 700,
      "width": 480,
      "height": 200,
      "color": "6"
    },
    {
      "id": "build",
      "type": "text",
      "text": "# Construcción por puertas\nContratos → pruebas → componentes\nPiloto admitido → servicio → escala probada\nCada entrega con responsable y aceptación",
      "x": 1120,
      "y": 700,
      "width": 480,
      "height": 200,
      "color": "4"
    },
    {
      "id": "isolation",
      "type": "text",
      "text": "# Conocimiento independiente\nSolo archivos del repositorio Cardeex\nLegados: referencias históricas de auditoría\nSin memorias ni checkpoints paralelos",
      "x": 2220,
      "y": 700,
      "width": 480,
      "height": 200,
      "color": "1"
    },
    {
      "id": "foundation_file",
      "type": "file",
      "file": "docs/CARDEEX_FOUNDATION.md",
      "x": 0,
      "y": -960,
      "width": 370,
      "height": 210
    },
    {
